<?xml version="1.0" encoding="utf-8"?>
<!-- Git changes destination: list of changed files, local commit and explicit push. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/git_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/git_toolbar"
        style="@style/Widget.OpenCode.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationContentDescription="@string/opencode_git_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/opencode_git_title" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.6"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/git_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/git_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/git_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_input"
            android:padding="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.OpenCode.BodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/git_change_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_sm"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/git_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_step_done"
                    android:tint="@color/oc_success" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/opencode_git_clean_title"
                    android:textAppearance="@style/TextAppearance.OpenCode.BodyLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:text="@string/opencode_git_clean_desc"
                    android:textAppearance="@style/TextAppearance.OpenCode.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/git_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/git_commit_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/git_message_layout"
                style="@style/Widget.OpenCode.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/opencode_files_git_message_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/git_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/git_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:minHeight="@dimen/touch_target"
                android:text="@string/opencode_files_git_auto_toggle"
                android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/git_commit_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:checked="true"
                android:text="@string/opencode_git_commit_all"
                android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opencode_files_git_auto_hint"
                android:textAppearance="@style/TextAppearance.OpenCode.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/git_push"
                    style="@style/Widget.OpenCode.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/opencode_files_git_push"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/git_commit"
                    style="@style/Widget.OpenCode.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:minWidth="0dp"
                    android:text="@string/opencode_files_git_commit"
                    app:icon="@drawable/ic_git_repo"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
