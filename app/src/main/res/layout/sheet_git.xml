<?xml version="1.0" encoding="utf-8"?>
<!-- Commit and push the repository that contains the folder open in Files. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/spacing_lg">

    <TextView
        android:id="@+id/sheet_git_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/opencode_files_git_sheet_title"
        android:textAppearance="@style/TextAppearance.OpenCode.TitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/sheet_git_repo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.OpenCode.MonoSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/sheet_git_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/sheet_git_changes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:ellipsize="end"
        android:maxLines="8"
        android:textAppearance="@style/TextAppearance.OpenCode.MonoSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/sheet_git_message_layout"
        style="@style/Widget.OpenCode.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/opencode_files_git_message_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sheet_git_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/sheet_git_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_git_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/opencode_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_git_commit"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:minWidth="0dp"
            android:text="@string/opencode_files_git_commit_push"
            app:icon="@drawable/ic_git_repo"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
