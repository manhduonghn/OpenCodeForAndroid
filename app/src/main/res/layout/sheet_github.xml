<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub controls: the single account/clone/repository sheet, opened from Files. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_lg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opencode_settings_github"
            android:textAppearance="@style/TextAppearance.OpenCode.TitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/opencode_settings_github_desc"
            android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/github_sheet_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <ProgressBar
            android:id="@+id/github_sheet_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/github_install_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_input"
            android:maxLines="8"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.OpenCode.MonoSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_install"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="40dp"
            android:minWidth="0dp"
            android:text="@string/opencode_settings_github_install"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_login"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="40dp"
            android:minWidth="0dp"
            android:text="@string/opencode_settings_github_connect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_logout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:minHeight="40dp"
            android:minWidth="0dp"
            android:text="@string/opencode_settings_github_disconnect"
            android:visibility="gone" />

        <TextView
            android:id="@+id/github_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/github_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.OpenCode.MonoCode"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/github_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:text="@string/opencode_settings_github_copy"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/github_link"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:text="@string/opencode_settings_github_link"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/github_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.OpenCode.BodySmall"
            android:textColor="?attr/colorOutline"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/github_clone_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/github_clone_url_layout"
                style="@style/Widget.OpenCode.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/opencode_settings_github_url">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/github_clone_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/github_clone"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:text="@string/opencode_settings_github_clone" />

            <TextView
                android:id="@+id/github_clone_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:maxLines="10"
                android:padding="12dp"
                android:textAppearance="@style/TextAppearance.OpenCode.MonoSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/github_repo_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/opencode_settings_github_repos"
                android:textAppearance="@style/TextAppearance.OpenCode.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/github_repo_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.OpenCode.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/github_repo_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/github_sheet_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_md"
            android:minWidth="0dp"
            android:text="@string/opencode_ok" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
