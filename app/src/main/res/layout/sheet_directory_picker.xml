<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet of the directory picker: breadcrumb, shortcuts, path input and folder list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:text="@string/opencode_picker_title"
        android:textAppearance="@style/TextAppearance.OpenCode.TitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/picker_breadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opencode_picker_shortcuts"
            android:textAppearance="@style/TextAppearance.OpenCode.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/picker_shortcuts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_margin">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/picker_path_layout"
            style="@style/Widget.OpenCode.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/opencode_picker_path">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/picker_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/picker_go"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:minWidth="0dp"
            android:text="@string/opencode_picker_go" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="@dimen/spacing_sm">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/picker_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_sm"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/picker_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/opencode_picker_empty"
            android:textAppearance="@style/TextAppearance.OpenCode.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/picker_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorPrimary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/picker_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/opencode_picker_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/picker_choose"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/opencode_picker_choose"
            app:icon="@drawable/ic_folder"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
