<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the adaptive launcher icon.

  A warm diagonal gradient in the OpenCode orange, a soft highlight in the upper left and a
  vignette in the lower right. The extra light gives the flat color the depth that the modern
  launcher icons have, while the edges stay flat because the launcher clips them with its own
  mask (circle, squircle, rounded square, ...).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFFFB067" />
                <item android:offset="0.48" android:color="#FFF97332" />
                <item android:offset="1" android:color="#FFC2410F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft sheen, upper left. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="8"
                android:gradientRadius="66">
                <item android:offset="0" android:color="#40FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Vignette, lower right. Keeps the sheen from looking like a flat wash. -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="94"
                android:centerY="108"
                android:gradientRadius="86">
                <item android:offset="0" android:color="#38000000" />
                <item android:offset="1" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
