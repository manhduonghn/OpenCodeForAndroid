<?xml version="1.0" encoding="utf-8"?>
<!--
  The app shell has four primary destinations: refresh the Web UI, open the native
  Terminal, open Files and open Settings. Server restart/stop, the server address and
  About live inside Settings only, so the same action never appears twice.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_refresh"
        android:icon="@drawable/ic_refresh"
        android:title="@string/opencode_webui_refresh"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_terminal"
        android:icon="@drawable/ic_terminal"
        android:title="@string/opencode_terminal_title"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_files"
        android:icon="@drawable/ic_folder_open"
        android:title="@string/opencode_files_title"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings"
        android:title="@string/opencode_settings"
        app:showAsAction="always" />
</menu>
